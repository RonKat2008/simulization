# One private repository-root .env; all product launchers load it. Shell values win.
DATABASE_URL=
# Vercel AI Gateway; all three merchant providers use this gateway.
AI_GATEWAY_API_KEY=
AGENTRELAY_API_KEY=
AGENTRELAY_BASE_URL=https://armadillo.agentrelay.com/v1
# E's persisted Opus reviewer uses the direct Anthropic provider.
ANTHROPIC_API_KEY=

# Terse is the only actor runtime. Neon is reporting/projection storage.
AGENT_STORE=terse
DURABLE_ACTORS_URL=http://127.0.0.1:7100
DURABLE_ACTORS_PROJECT_ID=local
DURABLE_ACTORS_DATA_DIR=.durable-actors
# Optional local control-plane authentication; never expose to browsers.
DURABLE_ACTORS_SECRET=

WEB_URL=http://localhost:3000
SIM_URL=http://localhost:3000/api
NEXT_PUBLIC_SIM_URL=/api
# Live is the default. Set SIM_RUN_MODE=stub only for an explicitly labeled rehearsal.
SIM_RUN_MODE=live
# Leave MODEL_MODE unset for live runs. No silent model fallback is allowed.
# Optional web port override: PORT=3000

# Optional tools, not merchant inference credentials.
OPENAI_API_KEY=
V0_API_KEY=
