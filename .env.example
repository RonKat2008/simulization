DATABASE_URL=
AGENTRELAY_API_KEY=
# Gateway TBD by Person B (confirm from its docs; do not guess)
AI_GATEWAY_API_KEY=
ANTHROPIC_API_KEY=
# Confirm the exact variable name from the Terse docs
TERSE_API_KEY=
# Actor runtime: terse only; Neon is database/projection storage
AGENT_STORE=terse
SIM_URL=http://localhost:8787
NEXT_PUBLIC_SIM_URL=http://localhost:8787
WEB_URL=http://localhost:3000
# Terse Durable Actors control plane (AGENT_STORE=terse)
DURABLE_ACTORS_URL=http://127.0.0.1:7100
DURABLE_ACTORS_PROJECT_ID=local
# Optional bearer; required only when the control plane sets DURABLE_ACTORS_SECRET. Never expose to browsers.
DURABLE_ACTORS_SECRET=
# v0 Platform API (design generation only; never commit the real key)
V0_API_KEY=

# Local actor runtime; Bun >=1.4.2 must be on PATH
DURABLE_ACTORS_DATA_DIR=.durable-actors
PORT=8787

# Both runtime commands explicitly load this root .env; Neon is reporting storage only.
# Optional: direct OpenAI key (agents normally go through AI_GATEWAY_API_KEY)
OPENAI_API_KEY=
