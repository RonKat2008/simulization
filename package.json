{
  "name": "simulization",
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "node workers/sim/scripts/web-dev.mjs",
    "dev:sim": "pnpm actors:dev",
    "actors:dev": "pnpm --filter actors dev",
    "mock": "pnpm --filter @simulization/shared mock",
    "sim:local": "pnpm --filter sim sim:local",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "batch": "pnpm --filter sim exec tsx ../../scripts/run-batch.ts"
  }
}
