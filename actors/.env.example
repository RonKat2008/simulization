# Copy to actors/.env (Bun loads it for `durable-actors dev`). Never commit .env.

# Model gateway key. If missing, MerchantAgent.takeTurn returns a pass output (local runs still work).
AI_GATEWAY_API_KEY=
# AgentRelay (optional). If AGENTRELAY_API_KEY is unset, the world-built inbox is used.
AGENTRELAY_API_KEY=
AGENTRELAY_BASE_URL=

# ExperimentRunner targets
SIM_URL=http://127.0.0.1:8787
WEB_URL=http://127.0.0.1:3000

# Durable Actors connection (used by the sim / generated client, not by the actors themselves).
# Local dev needs none of these: control plane http://127.0.0.1:7100, project id "local".
# DURABLE_ACTORS_CONTROL_PLANE_URL=http://127.0.0.1:7100
# DURABLE_ACTORS_PROJECT_ID=local
# DURABLE_ACTORS_SECRET=   # optional shared secret; must be identical on server and backend. Keep out of browser code.
