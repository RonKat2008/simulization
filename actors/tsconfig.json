{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@simulization/shared": [
        "./vendor/shared/index.ts"
      ],
      "@simulization/agents": [
        "./vendor/agents/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "vendor"
  ]
}
