{
  "name": "actors",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "vendor": "node scripts/prepare-runtime.mjs",
    "dev": "pnpm --filter sim exec bun scripts/consolidated-dev.ts",
    "generate": "node scripts/prepare-runtime.mjs && bunx durable-actors generate src/runtime.ts",
    "inspect": "bunx durable-actors inspect",
    "observe": "bunx durable-actors observe",
    "typecheck": "node scripts/prepare-runtime.mjs && tsc --noEmit"
  },
  "dependencies": {
    "@simulization/agents": "workspace:*",
    "@simulization/shared": "workspace:*",
    "durable-actors": "0.14.6",
    "zod": "^4.6.7",
    "@neondatabase/serverless": "1.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "~5.9.3"
  },
  "trustedDependencies": [
    "esbuild"
  ]
}
